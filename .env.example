# Supabase (local: npx supabase start → copy from `supabase status`)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only — never expose to the browser or Client Components
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Phase 2+: Google OAuth (configure in Supabase Auth + Google Cloud Console)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

NEXT_PUBLIC_SITE_URL=http://localhost:3000
